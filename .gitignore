
# =====================================
# 1. DATASET - DVC MANAGES DATA
# =====================================
/data/

# =====================================
# 2. MODEL WEIGHTS - DVC MANAGES MODELS
# =====================================

# Ignore model weights, but allow DVC pointers
/resnet_model/*.pth
/mobilenet_model/*.pth
/cnn_model/*.pth

# Other model formats
*.pth
*.pt
*.onnx

# Keep DVC pointer files
!*.dvc

# =====================================
# 3. PYTHON
# =====================================
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# =====================================
# 4. RETRAINING OUTPUTS
# =====================================
/outputs/
/checkpoints/

# =====================================
# 5. MLFLOW LOCAL FILES
# =====================================
mlruns/
*.db

# =====================================
# 6. CREDENTIALS
# =====================================
.env
.env.*
!.env.example
kaggle.json
credentials.json
token.json
.dvc/config.local

# =====================================
# 7. LOCAL FILES
# =====================================
.vscode/
*.log
*.jpg
*.jpeg
*.png

# =====================================
# 8. TEMPORARY KAGGLE DATA
# =====================================
/kaggle_dataset/
/.stage2_dataset/
/.stage2_kernel/
/.stage3_dataset/
/.stage3_kernel/
/stage2_logs/
/stage3_logs/
